# ==============================================================================
# FACENIA FACTURACIÓN - VARIABLES DE ENTORNO
# ==============================================================================
# La aplicación funciona al 100% en modo local sin necesidad de servicios remotos.
# Si desea sincronizar con un proyecto propio de Supabase, complete los siguientes valores:

# URL de su proyecto Supabase (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (Dashboard -> Project Settings -> API -> Anon / Public key)
# NUNCA coloque aquí la service_role key.
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
